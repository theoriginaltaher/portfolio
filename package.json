{
  "name": "taher-portfolio-kombai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "studio": "node --env-file=.env.local node_modules/sanity/bin/sanity dev",
    "sanity:configure": "node scripts/configure-sanity.mjs",
    "sanity:audit": "node --env-file=.env.local scripts/audit-sanity.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "verify:isr": "node --env-file=.env.local scripts/verify-isr.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/postcss": "latest",
    "next": "latest",
    "next-sanity": "^13.3.1",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.18.1",
    "sanity": "^6.9.1",
    "sharp": "^0.35.3",
    "styled-components": "^6.5.0",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^12.8.2",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
